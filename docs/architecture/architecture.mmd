---
title: System Architecture - CRF Sequence Labeler
config:
  theme: base
  themeVariables:
    fontFamily: "Inter, system-ui, sans-serif"
    primaryColor: "#F8FAFC"
    primaryBorderColor: "#1E293B"
    primaryTextColor: "#1E293B"
    lineColor: "#64748B"
    clusterBkg: "#EEF2FF"
    clusterBorder: "#94A3B8"
---
flowchart TB
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    Client([Client]):::edge

    subgraph Train["Training (once at startup)"]
        direction TB
        Data[(Labeled BIO data)]:::data
        Features[Emission features<br/>word, shape, affixes, context]:::core
        Gradient["Forward-backward<br/>empirical minus expected counts"]:::core
    end

    Weights[(Emission + transition weights)]:::data

    subgraph Edge["Service layer (stdlib HTTP, stateless)"]
        direction TB
        Router["Router<br/>/health | /ready | /metrics | /tag | /evaluate"]:::core
        Validate["Validation<br/>bounded token list"]:::control
    end

    Viterbi["Viterbi decoding<br/>most probable label path"]:::core
    Result["BIO tags + entity spans"]:::obs

    Data --> Features --> Gradient -->|weights| Weights
    Client -->|JSON request| Router --> Validate
    Validate -->|tokens| Viterbi
    Weights -.-> Viterbi
    Viterbi -->|labels| Result
    Result --> Router -->|JSON response| Client
