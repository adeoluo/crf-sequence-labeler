flowchart LR
    classDef edge     fill:#F59E0B,stroke:#1E293B,color:#1E293B,stroke-width:1px;
    classDef core     fill:#6366F1,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef data     fill:#10B981,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef control  fill:#0EA5E9,stroke:#1E293B,color:#ffffff,stroke-width:1px;
    classDef obs      fill:#CBD5E1,stroke:#1E293B,color:#1E293B,stroke-width:1px;

    subgraph Interfaces["Interfaces"]
        direction TB
        Users([Users and clients]):::edge
        CLI["CLI<br/>evaluate, tag, serve"]:::edge
        Router["HTTP service<br/>/tag /evaluate /metrics"]:::core
        Validate["Validation<br/>token list, max 200"]:::control
        Users --> CLI ~~~ Router --> Validate
    end

    subgraph Train["Training (at startup)"]
        direction TB
        Dataset[("BIO dataset<br/>train and test splits")]:::data
        Features["Emission features<br/>word, shape, affixes"]:::core
        FB["Forward-backward<br/>marginals and log Z"]:::core
        Trainer["Gradient ascent<br/>with L2 penalty"]:::core
        Config["TrainingConfig<br/>epochs, lr, l2, seed"]:::control
        Weights[("CRF weights<br/>emission, transition")]:::data
        Config ~~~ Dataset --> Features -->|emission scores| FB
        FB -->|expected counts| Trainer --> Weights
    end

    subgraph Decode["Decoding"]
        direction TB
        Viterbi["Viterbi decoding<br/>best label path"]:::core
        Spans["Span extraction<br/>BIO tags to entities"]:::core
        Viterbi --> Spans
    end

    subgraph Obs["Evaluation and observability"]
        direction TB
        Response["JSON response<br/>tags and entities"]:::obs
        Eval["Span evaluation<br/>precision, recall, F1"]:::obs
        Metrics["Metrics<br/>Prometheus text"]:::obs
        Response ~~~ Eval ~~~ Metrics
    end

    Interfaces -->|train| Train
    Interfaces -->|tokens| Decode
    Train -.->|weights| Decode
    Decode -->|spans| Obs
    Train -.->|test split| Obs
